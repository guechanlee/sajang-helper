# Supabase 프로젝트 설정 > API 에서 복사. anon 키는 공개용이고, 접근 제어는 DB의 RLS가 한다.
# service_role 키는 절대 여기에 넣지 않는다(브라우저로 노출되면 모든 데이터가 열린다).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# 로그인 링크가 돌아올 주소(개발: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
